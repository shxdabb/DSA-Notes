class Solution:
    def numIslands(self, grid: List[List[str]]) -> int:

        directions = [(0,1),(0,-1),(1,0),(-1,0)]
        count = 0
        

        #use dfs and travel as long as u can
        def dfs(i,j):

            # visited.add((i,j))

            # if grid[i][j]==0:
            #     return
            if grid[i][j]=='0':
                return
            grid[i][j] = "0"
            for dr,dc in directions:
                nr = i + dr
                nc = j + dc

                if 0<=nr<len(grid) and 0<=nc<len(grid[0]):
                    
                    dfs(nr,nc)
                        # count+=1

        for i in range(len(grid)):
            for j in range(len(grid[0])):
                if grid[i][j]=="1":
                    count+=1
                    dfs(i,j)

        return count

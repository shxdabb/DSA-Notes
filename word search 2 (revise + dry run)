#to solve it we have to add all words in the words array in a trie first, then start a dfs run from there, and have too explore all 4 directions,
but searching will be done in trie, so we have to keep track of the node where we are at,suppose the starting letter a is in the root and in the grid as well
all the words starring from a will 100 percent be in the children of a:{} then we can move the our current node to the children of a becuase any word like aab or aba
will be in the children of a:{} so if we find a matching word we move the node to its children, also we have to keep track of current path because while traversing grid
if we find matching word and it also has isEnd True we can append in a resultant array whic will be array of strings




```python

class TrieNode:
    def __init__(self):
        self.children = {}
        self.isEnd = False


class Solution:
    def findWords(self, board, words):
        root = TrieNode()

        for word in words:
            curr = root
            for c in word:
                if c not in curr.children:
                    curr.children[c] = TrieNode()
                curr = curr.children[c]
            curr.isEnd = True

        rows, cols = len(board), len(board[0])
        directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]
        result = []

        def dfs(i, j, node, path):
            char = board[i][j]

            if char not in node.children:
                return

            node = node.children[char]
            path += char

            if node.isEnd:
                result.append(path)
                node.isEnd = False

            board[i][j] = "#"

            for dr, dc in directions:
                nr, nc = i + dr, j + dc

                if 0 <= nr < rows and 0 <= nc < cols:
                    if board[nr][nc] != "#":
                        dfs(nr, nc, node, path)

            board[i][j] = char

        for i in range(rows):
            for j in range(cols):
                dfs(i, j, root, "")

        return result

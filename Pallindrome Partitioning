class Solution:


    def is_pall(self,t):
        l = 0
        r = len(t)-1
        while l<r:
            if t[l]!=t[r]:
                return False
            l+=1
            r-=1
        return True
    def partition(self, s: str) -> List[List[str]]:
        #at every level we can either partition or not
        #check at every level

        part = []
        res = []

        def dfs(i):
            if i >= len(s):
                res.append(part[:])
                return
            
            for j in range(i,len(s)):
                #this much striing we have to explore
                piece = s[i:j+1]
                if self.is_pall(piece):
                    part.append(piece)

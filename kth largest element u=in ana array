class Solution(object):
    def findKthLargest(self, nums, k):
        """
        :type nums: List[int] 
        :type k: int
        :rtype: int
        """

        enhanced_k = len(nums)-k #at this position we get our desired element in a  sorted array.

        l,r = 0,len(nums)-1

        #lets start partitioning recursiveley
        
        def QuickSelect(l,r):
            p = l
            pivot = nums[r]
            for i in range(l,r):
                if nums[i] <= pivot:
                    nums[i],nums[p] = nums[p],nums[i]
                    p+=1
            nums[p],nums[r] = nums[r],nums[p]
            if p < enhanced_k:
                return QuickSelect(p+1,r)
            elif p > enhanced_k:
                return QuickSelect(l,p-1)
            else:
                return nums[p]

        return QuickSelect(l,r)





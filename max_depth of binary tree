#         self.left = left
#         self.right = right
class Solution(object):
    def maxDepth(self, root):
        """
        :type root: Optional[TreeNode]
        :rtype: int
        """




        from collections import deque

        if not root:
            return 0

        q = deque()
        q.append(root)
        counter = 0

        while q:
            size = len(q)

            for i in range(size):
                node = q.popleft()
                if node.left:

                    q.append(node.left)
                if node.right:
                    
                    q.append(node.right)
            counter += 1
        

        return counter


for searching words we can use dfs recursion to search words 

```python
class TrieNode:
    def __init__(self):
        self.children = {}
        self.isEnd = False

class WordDictionary:

    def __init__(self):
        self.root = TrieNode() 

    def addWord(self, word: str) -> None:
        cur = self.root
        for c in word:
            if c not in cur.children:
                cur.children[c] = TrieNode()
            cur = cur.children[c]

        cur.isEnd = True

    def search(self, word: str) -> bool:
        #we will use a loop to iterate over the word, if we encounter . we 
        #will start a recursive search from there
        
        def dfs(root,j): #".ab" "abc" "ab."
            curr = root
            for i in range(j,len(word)):

                if word[i] == '.':
                    for char,child in curr.children.items():
                        if dfs(child,i+1):
                            return True
                    return False
                else:
                    if word[i] not in curr.children:
                        return False
                    curr = curr.children[word[i]]
            return curr.isEnd

        return dfs(self.root,0)


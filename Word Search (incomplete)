class Solution:
    def exist(self, board: List[List[str]], word: str) -> bool:
    
        visited = set()
        directions = ([-1,0],[1,0],[0,-1],[0,1])
        def backtrack(i,j,k):
            if k == len(word)-1:
                return True

            visited.add((i,j))
            for dr,dc in directions:
                nr = dr + i
                nc = dc + j

                if (0<=nr<len(board) and 0<=nc<len(board[0])
                and (nr,nc) not in visited and board[nr][nc] == word[k+1]):
                    if backtrack(nr,nc,k+1):
                        return True
                    
            visited.remove((i,j))
            return False

        for i in range(len(board)):
            for j in range(len(board[i])):
                if board[i][j] == word[0]:
                    if backtrack(i,j,0):
                        return True
        return False   
